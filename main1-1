#include <stdio.h>

int main(void)
{
	double a;
	double area,perimetr;
	printf ("Введите длину:\n");
	scanf("%1f",&a);
	area = a*a;
	perimetr = 4.0*a;
	printf("==========================================\n");
	printf ("       ПАРАМЕТРЫ квадрата\n");
	printf ("----------------------------------------\n");
	printf ("Длина:%.2f\n",a);
	printf ("Площадь:%.2f\n",area);
	printf ("Периметр:%.2f\n",perimetr);
	printf ("==========================================\n");
	printf ("Расчет завершон успешно\n");
	return 0;
}
