#include <stdio.h>

int main(void)
{
	double a,b;
	double area,perimetr;
	printf ("Введите длину и ширину прямоугольника:\n");
	scanf("%1f%1f",&a,&b);
	area = a * b;
	perimetr = 2.0 * (a + b);
	printf("==========================================\n");
	printf ("       ПАРАМЕТРЫ ПРЯМОУГОЛЬНИКА\n");
	printf ("----------------------------------------\n");
	printf ("Длина:%.2f\n",a);
	printf ("Ширина:%.2f\n",b);
	printf ("Площадь:%.2f\n",area);
	printf ("Периметр:%.2f\n",perimetr);
	printf ("==========================================\n");
	printf ("Расчет завершон успешно\n");
	return 0;
}
